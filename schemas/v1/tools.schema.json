            "end_date": {
              "type": "string"
            }
          }
        },
        "where": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "type": "string"
            },
            "campaign_id": {
              "type": "string"
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "gads_campaign_performance": {
      "$ref": "#/$defs/gads_search"
    },
    "license_status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "support_packet": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "last_tool": {
          "type": "string",
          "maxLength": 80
        },
        "error_code": {
          "type": "string",
          "maxLength": 64
        },
        "resource_id": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "feedback_prepare": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message",
        "reply_to"
      ],
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        },
        "reply_to": {
          "type": "string",
          "minLength": 3,
          "maxLength": 254
        },
        "kind": {
          "type": "string",
