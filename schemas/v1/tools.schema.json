      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "container_id": {
          "$ref": "#/$defs/container_id"
        }
      }
    },
    "gtm_list_workspaces": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id",
        "container_id"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
