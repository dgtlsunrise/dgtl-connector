        "ad_account_id": {
          "type": "string",
          "minLength": 1
        },
        "level": {
          "type": "string",
          "enum": [
            "account",
            "campaign",
            "adset",
            "ad"
          ]
        },
        "object_id": {
          "type": "string",
          "minLength": 1
        },
        "date_start": {
          "type": "string",
          "minLength": 1
        },
        "date_stop": {
          "type": "string",
          "minLength": 1
        },
        "date_preset": {
          "type": "string",
          "enum": [
            "today",
            "yesterday",
            "last_7d",
            "last_14d",
            "last_28d",
            "last_30d",
            "last_90d",
            "this_month",
            "last_month",
            "lifetime",
            "maximum"
          ]
