            "bug",
            "feature",
            "other"
          ]
        },
        "last_tool": {
          "type": "string",
          "maxLength": 80
        },
        "error_code": {
          "type": "string",
          "maxLength": 64
        },
        "resource_id": {
          "type": "string",
          "maxLength": 256
        }
      }
    },
    "feedback_send": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirm"
      ],
      "properties": {
