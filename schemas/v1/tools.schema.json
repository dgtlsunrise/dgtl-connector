{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgtlsunrise.local/spec/dgtl-connector/v1/tools.schema.json",
  "title": "dgtl-connector v1 tool parameters (closed, 24 Consent A tools + gated families)",
  "$comment": "Implementers map each $defs key to an MCP tool inputSchema. Resource IDs are required; never default. dimension_filter is a closed FilterExpression subset.",
  "$defs": {
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "page_token": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "minLength": 1,
      "description": "GA4 accounts/{id} or GTM account id. Not 'default'."
    },
    "property_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(properties/)?[0-9]+$",
      "description": "GA4 properties/{id}"
    },
    "site_url": {
      "type": "string",
      "minLength": 1,
      "description": "Exact Search Console property, e.g. https://example.com/ or sc-domain:example.com"
    },
    "container_id": {
      "type": "string",
      "minLength": 1
    },
    "workspace_id": {
      "type": "string",
      "minLength": 1
    },
    "google_whoami": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "ga4_list_accounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "$ref": "#/$defs/page_size"
        },
        "page_token": {
          "$ref": "#/$defs/page_token"
        }
      }
    },
    "ga4_list_account_summaries": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_size": {
          "$ref": "#/$defs/page_size"
        },
        "page_token": {
          "$ref": "#/$defs/page_token"
        }
      }
    },
    "ga4_list_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_id"
      ],
      "properties": {
        "account_id": {
          "$ref": "#/$defs/account_id"
        },
        "page_size": {
          "$ref": "#/$defs/page_size"
        },
        "page_token": {
          "$ref": "#/$defs/page_token"
        }
      }
    },
    "ga4_get_property": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/property_id"
        }
      }
    },
    "ga4_list_data_streams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/property_id"
        },
        "page_size": {
          "$ref": "#/$defs/page_size"
        },
        "page_token": {
          "$ref": "#/$defs/page_token"
        }
      }
    },
    "ga4_list_key_events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/property_id"
        },
        "page_size": {
          "$ref": "#/$defs/page_size"
        },
        "page_token": {
          "$ref": "#/$defs/page_token"
        }
      }
    },
    "ga4_get_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/property_id"
        },
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Substring filter on apiName/uiName/description"
        },
        "kind": {
          "type": "string",
          "enum": [
            "dimension",
            "metric",
            "all"
          ]
        },
        "custom_only": {
          "type": "boolean"
        }
      }
    },
    "ga4_run_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "date_ranges",
        "metrics"
      ],
      "properties": {
        "property_id": {
          "$ref": "#/$defs/property_id"
        },
        "date_ranges": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start_date",
              "end_date"
            ],
            "properties": {
              "start_date": {
                "type": "string"
              },
              "end_date": {
                "type": "string"
              }
            }
          }
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensions": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimension_filter": {
          "$ref": "#/$defs/filter_expression"
        },
        "metric_filter": {
          "$ref": "#/$defs/filter_expression"
        },
        "order_bys": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "dimension",
                  "metric"
                ]
              },
              "desc": {
                "type": "boolean"
              }
            }
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "keep_empty_rows": {
          "type": "boolean"
        },
        "currency_code": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "allow_long_range": {
          "type": "boolean"
        }
      }
    },
    "filter_expression": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "and"
          ],
          "properties": {
            "and": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filter_expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "or"
          ],
          "properties": {
            "or": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/filter_expression"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/filter_expression"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "string_filter"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "string_filter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "value"
              ],
              "properties": {
                "match_type": {
                  "type": "string",
                  "enum": [
                    "EXACT",
                    "BEGINS_WITH",
                    "ENDS_WITH",
                    "CONTAINS",
                    "FULL_REGEXP",
                    "PARTIAL_REGEXP"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "case_sensitive": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "in_list"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "in_list": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "case_sensitive": {
                  "type": "boolean"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "field",
            "numeric_filter"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "numeric_filter": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "operation",
                "value"
              ],
              "properties": {
                "operation": {
                  "type": "string",
                  "enum": [
                    "EQUAL",
                    "LESS_THAN",
                    "LESS_THAN_OR_EQUAL",
                    "GREATER_THAN",
                    "GREATER_THAN_OR_EQUAL"
                  ]
                },
                "value": true
              }
            }
          }
        }
      ]
    },
    "gsc_list_sites": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    },
    "gsc_get_site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url"
      ],
      "properties": {
        "site_url": {
          "$ref": "#/$defs/site_url"
        }
      }
    },
    "gsc_query_search_analytics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url",
        "start_date",
        "end_date"
      ],
      "properties": {
        "site_url": {
          "$ref": "#/$defs/site_url"
        },
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "query",
              "page",
              "country",
              "device",
              "searchAppearance",
              "date",
              "hour"
            ]
          }
        },
        "row_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "start_row": {
          "type": "integer",
          "minimum": 0
        },
        "search_type": {
          "type": "string",
          "enum": [
            "web",
            "image",
            "video",
            "news",
            "discover",
            "googleNews"
          ]
        },
        "data_state": {
          "type": "string",
          "enum": [
            "final",
            "all"
          ]
        },
        "aggregation_type": {
          "type": "string"
        },
        "dimension_filter_groups": {
          "type": "array"
        }
      }
    },
    "gsc_inspect_url": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url",
        "inspection_url"
      ],
      "properties": {
        "site_url": {
          "$ref": "#/$defs/site_url"
        },
        "inspection_url": {
          "type": "string",
          "minLength": 1
        },
        "language_code": {
          "type": "string"
        }
      }
    },
    "gsc_list_sitemaps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url"
      ],
      "properties": {
        "site_url": {
          "$ref": "#/$defs/site_url"
        },
        "sitemap_index": {
          "type": "string"
        }
      }
    },
    "gsc_get_sitemap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "site_url",
        "feedpath"
      ],
      "properties": {
        "site_url": {
          "$ref": "#/$defs/site_url"
        },
        "feedpath": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gtm_list_accounts": {
      "type": "object",
      "additionalProperties": false,
