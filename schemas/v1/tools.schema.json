        "breakdowns": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "fields": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "time_increment": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          ]
        }
      },
      "required": [
        "ad_account_id"
      ]
    },
