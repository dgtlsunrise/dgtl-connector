# Public Desktop OAuth client id.
GOOGLE_OAUTH_CLIENT_ID=

# Desktop token exchange needs the Console client secret in *this machine's*
# gitignored .env only. Leave unset in this example. Never commit a real value.
# GOOGLE_OAUTH_CLIENT_SECRET=

# Host-injected access token (stdio Manual auth). Not a Connect card.
GOOGLE_ACCESS_TOKEN=
GOOGLE_GRANTED_SCOPES=
GOOGLE_ACCOUNT_EMAIL=

# Optional paid license JWT (local verify). Prefer: auth redeem --code|--checkout-id
# (POST /v1/license → PLUGIN_DATA/license.jwt). Not an Ads developer-token.
DGTL_LICENSE_JWT=

# DGTL Worker base URL for Ads/Meta gateway + license redeem (no trailing slash).
# Live: https://stamp.dgtlsunrise.com (backup: https://dgtl-stamp.noel-4ea.workers.dev)
# Unset + valid JWT → GATEWAY_UNAVAILABLE. auth redeem needs this URL.
# Never put developer-token here.
# DGTL_GATEWAY_URL=
# Optional feedback endpoint override. Default is ${DGTL_GATEWAY_URL}/v1/feedback.
# Destination mailbox is support@dgtlsunrise.com (Reply-To = the address the user provided).
# DGTL_FEEDBACK_URL=
# Power-user DGTL_ADS_DEVELOPER_TOKEN bypass is unimplemented.

# GBP stays off until DGTL's GCP project has non-zero quota.
DGTL_GBP_ENABLED=false

# Consent W — separate OAuth client for writes (never Consent A).
# Leave unset until a write client exists. Never commit real values.
# GOOGLE_OAUTH_WRITE_CLIENT_ID=
# GOOGLE_OAUTH_WRITE_CLIENT_SECRET=
# Or put the same two keys in gitignored .env.write.local (loaded for auth login-write).
# Host-injected write token (separate from GOOGLE_ACCESS_TOKEN).
# GOOGLE_WRITE_ACCESS_TOKEN=
# GOOGLE_WRITE_GRANTED_SCOPES=

# GTM/GSC/GA4 write tool stubs. Default off; free Consent A stays readonly.
DGTL_WRITES_ENABLED=false

# Consent C — Google Ads user OAuth (separate client; never Consent A).
# auth login-ads uses GOOGLE_OAUTH_ADS_CLIENT_ID → PLUGIN_DATA/google-oauth-ads.json
# GOOGLE_OAUTH_ADS_CLIENT_ID=
# GOOGLE_OAUTH_ADS_CLIENT_SECRET=
# GOOGLE_ADS_ACCESS_TOKEN=
# GOOGLE_ADS_GRANTED_SCOPES=

# Meta user OAuth (Login for Business). App secret stays on the Worker.
# Host-injected META_ACCESS_TOKEN, or: auth login-meta --code <grant> (needs DGTL_GATEWAY_URL).
# META_APP_ID=
# META_ACCESS_TOKEN=
# META_GRANTED_SCOPES=

# TikTok Ads — Polar feature `tiktok` (not ads/meta) + stamp hop. App secret stays on the Worker.
# Host-injected TIKTOK_ACCESS_TOKEN or PLUGIN_DATA/tiktok-oauth.json.
# Live app + Marketing API + Polar mint are Noel gates. Code uses fixtures until then.
# TIKTOK_ACCESS_TOKEN=
# TIKTOK_GRANTED_SCOPES=
# Plugin mutate defaults on; Worker TIKTOK_MUTATE_ENABLED stays fail-closed.
# DGTL_TIKTOK_MUTATE_ENABLED=true

# Shopify Admin API — merchant-held local credentials (free read lane; no Polar/stamp).
# Default custom-app scopes: read_products + read_orders + read_inventory + read_locations.
# write_inventory is an explicit merchant-app expansion; also needs the writes flag on at runtime (keep it false in this file).
# SHOPIFY_STORE=example.myshopify.com
# SHOPIFY_ACCESS_TOKEN=shpat_...
# SHOPIFY_GRANTED_SCOPES=read_products,read_orders,read_inventory,read_locations
# Optional Dev Dashboard client_credentials (refresh into PLUGIN_DATA/shopify-oauth.json):
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=

# Optional local audit.jsonl under PLUGIN_DATA (redacted: no tokens/JWT/rows).
DGTL_AUDIT_LOCAL=false

# Optional support host label (Grok Bot / Cursor / Grok Build / other).
# DGTL_HOST=
