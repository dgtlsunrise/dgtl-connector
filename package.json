{
  "name": "dgtl-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Local stdio MCP plugin for GA4, Search Console, and Tag Manager. Data stays on the user's computer.",
  "author": {
    "name": "DGTL Sunrise",
    "email": "noel@dgtlsunrise.com"
  },
  "bin": {
    "dgtl-connector-mcp": "./bin/dgtl-connector-mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:mcp": "node scripts/generate-mcp-json.mjs",
    "build": "npm run generate:mcp && tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --import tsx --test --test-timeout=60000 tests/*.test.ts",
    "validate:spec": "python3 scripts/validate-spec.py",
    "secret-scan": "bash scripts/secret-scan.sh",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
